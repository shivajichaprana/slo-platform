# Copy to terraform.tfvars and edit. terraform.tfvars is gitignored; this
# example is not, so it carries placeholders and never a real account.

aws_region  = "us-east-1"
environment = "dev"

# Part of every derived resource name. Short on purpose: an objective's own
# name has to fit in what is left of the 64-character ceiling.
name_prefix = "slo"

# Empty means unpinned. Listing the account is the cheapest protection against
# applying one environment's objectives to another environment's account.
allowed_account_ids = ["123456789012"]

# Objective specifications are read from inside the repository so that they are
# reviewed in the same change as the alerts generated from them.
spec_dir          = "specs"
spec_file_pattern = "*.yaml"

tags = {
  Owner = "<your-team>"
}
